# Copia este archivo a .env y completa los valores reales.
# Genera una clave nueva con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-secreta-generada
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Correo (recuperación de contraseña).
# Deja el backend de consola para probar sin credenciales reales
# (los correos se imprimen en la terminal). Para enviar correos de
# verdad con Gmail, comenta la línea de EMAIL_BACKEND y descomenta
# el resto, usando una "contraseña de aplicación" (no tu contraseña normal).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu_correo@gmail.com
# EMAIL_HOST_PASSWORD=tu_contraseña_de_aplicacion
# DEFAULT_FROM_EMAIL=MedAlert <tu_correo@gmail.com>

FRONTEND_URL=http://localhost:5173
